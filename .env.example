# IdeaVault Database Configuration
# Use these variable names in Railway environment variables

# Database Host (Railway MySQL connection)
IDEAVAULT_DB_HOST=mysql.railway.internal
IDEAVAULT_DB_PORT=3306

# Database Name
IDEAVAULT_DB_NAME=railway

# Database User
IDEAVAULT_DB_USER=root

# Database Password
IDEAVAULT_DB_PASSWORD=your_secure_password_here

# Google OAuth (Optional - only if using Google sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-app-domain.up.railway.app/google-callback.php
